# ─────────────────────────────────────────────────────────────────────────────
# AgentFlow configuration. Copy to `.env` and fill in. Never commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# --- App ---------------------------------------------------------------------
APP_ENV=development                 # development | production | test
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
# Sign session cookies. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
SESSION_HOURS=12

# --- Auth (single local user) ------------------------------------------------
AUTH_ENABLED=true
ADMIN_USERNAME=admin
# Prefer a bcrypt hash in production:
#   python -c "import bcrypt;print(bcrypt.hashpw(b'pw',bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=admin                # dev only; ignored when ADMIN_PASSWORD_HASH is set

# --- Database ----------------------------------------------------------------
# SQLite (default, zero setup):
DATABASE_URL=sqlite+aiosqlite:///./data/agentflow.db
# PostgreSQL (docker compose exposes 5433 to avoid clashing with a local 5432):
# DATABASE_URL=postgresql+asyncpg://agentflow:agentflow@localhost:5433/agentflow

# --- LLM providers -----------------------------------------------------------
DEFAULT_LLM_PROVIDER=anthropic      # anthropic | gemini
ANTHROPIC_API_KEY=
# Default model for all agents (validated against the provider's live model list).
ANTHROPIC_DEFAULT_MODEL=claude-opus-5-5
# Server-side refusal fallback (Claude API only). true | false
ANTHROPIC_ENABLE_FALLBACKS=true

GEMINI_API_KEY=
# Pick an ID from GET /api/v1/models once GEMINI_API_KEY is set.
GEMINI_DEFAULT_MODEL=

# Optional per-agent overrides (provider:model). Agent settings in the UI take precedence.
# AGENT_MODEL_PLANNER=anthropic:claude-opus-5-5
# AGENT_MODEL_RESEARCH=anthropic:claude-sonnet-5-5

# --- Web search --------------------------------------------------------------
TAVILY_API_KEY=
SEARCH_CREDITS_PER_QUERY=1

# --- Execution limits (per-task defaults; tasks may lower, never exceed MAX_*) -
DEFAULT_MAX_TOTAL_TOKENS=400000
DEFAULT_MAX_LLM_CALLS=40
DEFAULT_MAX_TOOL_CALLS=60
DEFAULT_TIMEOUT_SECONDS=900
DEFAULT_MAX_COST_USD=                # empty = no cost cap
DEFAULT_MAX_ITERATIONS=2
MAX_TOTAL_TOKENS_CEILING=2000000
MAX_CONCURRENT_TASKS=2
MAX_PARALLEL_SEARCHES=4             # concurrent web searches per task (protects rate limits)

# --- Pricing / approvals -----------------------------------------------------
PRICING_FILE=                        # empty = bundled app/config/pricing.json
APPROVAL_COST_THRESHOLD_USD=2.00
APPROVAL_TIMEOUT_HOURS=24

# --- Storage -----------------------------------------------------------------
DATA_DIR=./data
